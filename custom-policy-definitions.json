  },
  {
    "name": "audit-deny-apim-public-network-access",
    "referenceId": "AuditDenyApiManagementPublicNetworkAccess",
    "initiativeParameter": "Effect-ApiManagement",
    "properties": {
      "policyType": "Custom",
      "mode": "Indexed",
      "displayName": "API Management services should disable public network access",
      "description": "Audits or denies API Management services unless public network access is disabled.",
      "metadata": {
        "category": "API Management",
        "version": "1.0.0"
      },
      "parameters": {
        "effect": {
          "type": "String",
          "metadata": {
            "displayName": "Effect",
            "description": "Audit, deny, or disable this public network access policy."
          },
          "allowedValues": [
            "Audit",
            "Deny",
            "Disabled"
          ],
          "defaultValue": "Audit"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "field": "type",
              "equals": "Microsoft.ApiManagement/service"
            },
            {
              "field": "Microsoft.ApiManagement/service/publicNetworkAccess",
              "notEquals": "Disabled"
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]"
        }
      }
    }
  }
]
