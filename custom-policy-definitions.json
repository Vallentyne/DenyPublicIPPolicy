  {
    "name": "audit-deny-load-balancer-public-frontend",
    "referenceId": "AuditDenyExternalLoadBalancerPublicFrontend",
    "initiativeParameter": "Effect-ExternalLoadBalancer",
    "properties": {
      "policyType": "Custom",
      "mode": "Indexed",
      "displayName": "Load Balancers should not use public frontend IP configurations",
      "description": "Audits or denies external Load Balancers that use a public IP address or public IP prefix.",
      "metadata": {
        "category": "Network",
        "version": "1.0.0"
      },
      "parameters": {
        "effect": {
          "type": "String",
          "metadata": {
            "displayName": "Effect",
            "description": "Audit, deny, or disable this public network access policy."
          },
          "allowedValues": [
            "Audit",
            "Deny",
            "Disabled"
          ],
          "defaultValue": "Audit"
        }
      },
      "policyRule": {
        "if": {
          "allOf": [
            {
              "field": "type",
              "equals": "Microsoft.Network/loadBalancers"
            },
            {
              "anyOf": [
                {
                  "field": "Microsoft.Network/loadBalancers/frontendIPConfigurations[*].publicIPAddress.id",
                  "exists": true
                },
                {
                  "field": "Microsoft.Network/loadBalancers/frontendIPConfigurations[*].publicIPPrefix.id",
                  "exists": true
                }
              ]
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]"
