        "then": {
          "effect": "[parameters('effect')]"
        }
      }
    }
  },
  {
    "name": "audit-deny-front-door",
    "referenceId": "AuditDenyFrontDoor",
    "initiativeParameter": "Effect-FrontDoor",
    "properties": {
      "policyType": "Custom",
      "mode": "All",
      "displayName": "Azure Front Door should not be deployed",
      "description": "Audits or denies Front Door Classic, Standard and Premium profiles, and Front Door endpoints on existing profiles. Other CDN profile SKUs are not targeted. Private Link to an origin does not make the Front Door frontend private.",
      "metadata": {
        "category": "Network",
        "version": "1.0.0"
      },
      "parameters": {
        "effect": {
          "type": "String",
          "metadata": {
            "displayName": "Effect",
            "description": "Audit, deny, or disable this public network access policy."
          },
          "allowedValues": ["Audit", "Deny", "Disabled"],
          "defaultValue": "Audit"
        }
      },
      "policyRule": {
        "if": {
          "anyOf": [
            {
              "field": "type",
              "equals": "Microsoft.Network/frontDoors"
            },
            {
              "allOf": [
                {
                  "field": "type",
                  "equals": "Microsoft.Cdn/profiles"
                },
                {
                  "field": "Microsoft.CDN/profiles/sku.name",
                  "in": ["Standard_AzureFrontDoor", "Premium_AzureFrontDoor"]
                }
              ]
            },
            {
              "field": "type",
              "equals": "Microsoft.Cdn/profiles/afdEndpoints"
            }
          ]
        },
        "then": {
          "effect": "[parameters('effect')]"
        }
      }
    }
  }
]
